# ─── Notion Internal Integration Token ─────────────────────────────────
# 1. Go to notion.so/profile/integrations
# 2. Click "New integration" → type: Internal
# 3. Copy the "Internal Integration Secret" (starts with secret_...)
# 4. Share your Transactions, Categories, and Accounts databases with this integration
NOTION_TOKEN=

# ─── Notion Databases (already configured — leave unset, don't uncomment) ─────
# Each route falls back to a hardcoded default DB ID via `?? "..."`, which only
# triggers when the var is undefined. Setting it to an empty string ("KEY=")
# overrides the default with "" and breaks every Notion API call ("Invalid
# request URL."). Only uncomment + set these if you're pointing at different
# databases than the hardcoded defaults in each route file.
# NOTION_TRANSACTIONS_DB=
# NOTION_CATEGORIES_DB=
# NOTION_ACCOUNTS_DB=
# NOTION_RECONCILIATIONS_DB=

# ─── Sign-in gate (Notion OAuth, identity-only — does not touch data) ──
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
APP_URL=http://localhost:3000
SESSION_SECRET=            # openssl rand -base64 32
ALLOWED_NOTION_EMAILS=     # comma-separated, case-insensitive
